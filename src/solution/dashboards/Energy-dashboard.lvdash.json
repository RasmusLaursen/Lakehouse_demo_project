      "name": "e7a1c001",
      "displayName": "mv_energy_consumption",
      "asset_name": "mv_energy_consumption"
    },
    {
      "name": "e7a1c002",
      "displayName": "daily_summary",
      "queryLines": [
        "WITH daily AS (\n",
        "  SELECT `date`, MEASURE(total_consumption_kwh) AS kwh, MEASURE(total_cost_dkk) AS cost\n",
        "  FROM mv_energy_consumption\n",
        "  WHERE `date` >= date_sub(current_date(), 30)\n",
        "  GROUP BY `date`\n",
        "),\n",
        "latest AS (SELECT max(`date`) AS latest_date FROM daily WHERE kwh > 0)\n",
        "SELECT concat('Latest day (', date_format(l.latest_date, 'dd-MM-yyyy'), ')') AS period,\n",
        "  SUM(d.kwh) AS consumption_kwh, SUM(d.cost) AS cost_dkk, SUM(d.cost) / NULLIF(SUM(d.kwh), 0) AS avg_price_dkk_per_kwh\n",
        "FROM daily d CROSS JOIN latest l WHERE d.`date` = l.latest_date GROUP BY l.latest_date\n",
        "UNION ALL\n",
        "SELECT concat('Last 7 days (to ', date_format(l.latest_date, 'dd-MM-yyyy'), ')'),\n",
        "  SUM(d.kwh), SUM(d.cost), SUM(d.cost) / NULLIF(SUM(d.kwh), 0)\n",
        "FROM daily d CROSS JOIN latest l WHERE d.`date` BETWEEN date_sub(l.latest_date, 6) AND l.latest_date GROUP BY l.latest_date\n"
      ]
    },
    {
      "name": "e7a1c003",
      "displayName": "last_7_days_daily",
      "queryLines": [
        "WITH daily AS (\n",
        "  SELECT `date`, MEASURE(total_consumption_kwh) AS consumption_kwh, MEASURE(total_cost_dkk) AS cost_dkk\n",
        "  FROM mv_energy_consumption\n",
        "  WHERE `date` >= date_sub(current_date(), 30)\n",
        "  GROUP BY `date`\n",
        "),\n",
        "latest AS (SELECT max(`date`) AS latest_date FROM daily WHERE consumption_kwh > 0)\n",
        "SELECT d.`date`, d.consumption_kwh, d.cost_dkk\n",
        "FROM daily d CROSS JOIN latest l\n",
        "WHERE d.`date` BETWEEN date_sub(l.latest_date, 6) AND l.latest_date\n"
      ]
    }
  ],
